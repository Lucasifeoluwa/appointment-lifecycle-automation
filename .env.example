# Copy to .env and fill in. Never commit .env.

# Airtable base and table IDs (from the URL: airtable.com/appXXXX/tblYYYY/...)
AIRTABLE_BASE_ID=appXXXXXXXXXXXXXX
AIRTABLE_APPOINTMENTS_TABLE_ID=tblXXXXXXXXXXXXXX

# Google Calendar ID. Must be the email-style ID, not "primary":
# your Gmail address for your main calendar, or ...@group.calendar.google.com
# (Google Calendar > Settings > your calendar > Integrate calendar > Calendar ID)
GOOGLE_CALENDAR_ID=you@gmail.com

# Sender address for confirmations and reminders (SMTP credential lives in n8n)
FROM_EMAIL=bookings@example.com

# Slack incoming webhook for failure alerts
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ

# SMS reminders via Twilio (optional). Leave false to send email only.
SMS_ENABLED=false
TWILIO_FROM_NUMBER=+15005550006

GENERIC_TIMEZONE=Africa/Lagos
